[Unit]
Description=inkfall Gunicorn app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inkfall
Group=www-data
WorkingDirectory=/home/inkfall/project
ExecStart=/home/inkfall/project/.venv/bin/gunicorn --bind 127.0.0.1:8085 --workers 2 app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
